{
  "name": "q-hub-desktop",
  "productName": "Q-Hub",
  "version": "0.1.1",
  "description": "Q-Hub Desktop — програма поверх гри для гравців QuantRP",
  "main": "src/main.cjs",
  "private": true,
  "scripts": {
    "config": "node scripts/config.mjs",
    "start": "npm run config && electron .",
    "test": "node --test --test-force-exit src/*.test.cjs",
    "dist": "npm run config && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2"
  },
  "devDependencies": {
    "electron": "37.10.3",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "fun.q-hub.desktop",
    "productName": "Q-Hub",
    "files": [
      "src/**/*",
      "!src/*.test.cjs"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Q-Hub"
    }
  }
}
