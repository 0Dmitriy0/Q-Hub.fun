{
  "name": "q-hub-desktop",
  "productName": "Q-Hub",
  "version": "0.5.0",
  "description": "Q-Hub Desktop — програма поверх гри для гравців QuantRP",
  "main": "src/main.cjs",
  "private": true,
  "scripts": {
    "config": "node scripts/config.mjs",
    "start": "npm run config && npm run ocr && npm run ui && electron .",
    "test": "node --test --test-force-exit src/*.test.cjs",
    "dist": "npm run config && npm run ocr && npm run ui && electron-builder --win nsis --publish never",
    "ui": "npm --prefix .. run build:app",
    "ocr": "node scripts/ocr.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "electron-updater": "6.3.9",
    "koffi": "2.9.0",
    "tesseract.js": "6.0.1"
  },
  "devDependencies": {
    "electron": "37.10.3",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "fun.q-hub.desktop",
    "productName": "Q-Hub",
    "files": [
      "src/**/*",
      "!src/*.test.cjs",
      "!src/fixtures/**",
      "!node_modules/koffi/{src,doc,vendor}/**",
      "!node_modules/koffi/build/koffi/{darwin_*,freebsd_*,linux_*,musl_*,openbsd_*,win32_arm64,win32_i386}/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "shortcutName": "Q-Hub",
      "uninstallDisplayName": "${productName}",
      "artifactName": "Q-Hub-Setup-${version}.${ext}",
      "installerLanguages": [
        "uk_UA"
      ],
      "language": "1058",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installer-sidebar.bmp",
      "uninstallerSidebar": "build/installer-sidebar.bmp",
      "installerHeader": "build/installer-header.bmp",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/0Dmitriy0/Q-Hub.fun/releases/download/desktop-latest"
      }
    ],
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "src/ocr/**",
      "src/mapmatch.cjs",
      "src/mapmatch.worker.cjs",
      "node_modules/koffi/build/koffi/win32_x64/**"
    ]
  }
}
