/* SC-002: 30 питань гравців (15 правила, 15 закони) — потрібний пункт у топ-3 пошуку плашки щонайменше в 25.
   Запуск: curl -o rules.json <url>/storage/v1/object/public/rules/rules.json; node --experimental-strip-types specs/010-rules-sources/sc002-eval.mts rules.json */
import { readFileSync } from 'node:fs';
import { searchRules } from '../../src/desktop/rulesSearch.ts';
const r = JSON.parse(readFileSync(process.argv[2], 'utf8'));
const T = (i: number) => r.topics[i].title;
const Q: [string, number, RegExp][] = [
  ['що таке дм', 0, /Заборонено DM \(DeathMatch\)/],
  ['чи можна вбивати в зеленій зоні', 8, /Заборонено вбивство або заподіяння шкоди гравцям в ЗЗ/],
  ['що таке метагеймінг', 0, /MG \(MetaG/],
  ['скільки людей треба щоб пограбувати банк', 17, /грабувати банки в кількості менше ніж 6/],
  ['о котрій судна ніч', 7, /проводиться з 22:00/],
  ['можна мстити тому хто мене вбив', 0, /RK \(Revenge kill\)/],
  ['скільки учасників на захопленні території', 16, /Мінімальна кількість учасників на івенті - 5/],
  ['як зняти лідера державної фракції', 19, /Зняти лідера (держ|державної)/],
  ['чи можна катувати на допиті', 21, /допит\S* (з|із) елементами тортур/],
  ['образа адміністрації', 0, /образу, підкуп, неповажне ставлення/],
  ['чи можна використовувати баги', 0, /використання та приховування від адміністрації багів/],
  ['як почати напад на потяг', 11, /закласти вибухівку на колії/],
  ['за скільки треба забити бізвар', 15, /Запланувати захоплення бізнесу/],
  ['чи можна стріляти з машини', 0, /DB \(DriveBy\)/],
  ['відмова від рп при затриманні', 0, /ухиляння від РП/],
  ['покарання за вбивство', 32, /^\[Р\] Вбивство, тобто умисне/],
  ['хто має перевагу на перехресті', 29, /перехрестя в штаті є нерегульованими/],
  ['скільки можуть тримати затриманого', 34, /Після закінчення 1 години з моменту початку затримання/],
  ['як проводиться обшук при затриманні', 34, /первинн\S* обшук/],
  ['правило міранди', 34, /Формулювання правила міранди/],
  ['чи потрібна ліцензія на зброю', 53, /дозволяється лише у разі отримання відповідної ліцензії на зброю/],
  ['що таке відкрите носіння зброї', 53, /Відкрите носіння зброї - це/],
  ['чи можна полювати без ліцензії', 48, /мисливську діяльність .*ліцензію "На полювання"/],
  ['чи можна рибалити без ліцензії', 48, /аматорським рибальством без наявності/],
  ['перевищення службових повноважень', 32, /Перевищення посадових повноважень/],
  ['чи можна затримати сенатора з недоторканністю', 52, /не може бути піддана обшуку або затриманню|недоторканності не може бути притягнута/],
  ['чи можна заходити на базу нацгвардії', 54, /Червона Зона|особливо охороняються/],
  ['покарання за викрадення людини', 32, /Викрадення людини\./],
  ['покарання за викрадення авто', 32, /неправомірне заволодіння автомобілем/],
  ['поновлення на роботі після звільнення', 28, /14 днів з моменту звільнення/],
];
let ok = 0;
Q.forEach(([q, ti, re], k) => {
  const hits = searchRules(r.topics, q, 10);
  const pos = hits.findIndex(h => h.topic === T(ti) && re.test(h.s));
  if (pos >= 0 && pos < 3) ok++;
  console.log(`${k < 15 ? 'R' : 'L'}${String(k + 1).padStart(2)} ${pos >= 0 && pos < 3 ? '✓' : '✗'} ${pos < 0 ? '—' : '#' + (pos + 1)}  ${q}${pos >= 0 && pos < 3 ? '' : '\n      топ-3: ' + hits.slice(0, 3).map(h => `${h.topic.slice(0, 22)} ${h.n}`).join(' · ')}`);
});
console.log(`\nSC-002: ${ok}/30 (поріг 25)`);
