# Hostiq (Apache): усі шляхи сайту віддають index.html — маршрути обробляє сам застосунок.
# Для адрес зі статичною копією (dist/_p/<адреса>.html, scripts/static-pages.mjs) — її: та сама оболонка, але свій заголовок і
# текст для Google. Копії немає — на другому проході правило нижче віддає звичайний index.html
Options -MultiViews
RewriteEngine On
RewriteRule ^$ _p/index.html [L]
RewriteCond %{REQUEST_URI} !^/_p/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+?)/?$ _p/$1.html [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# сторінку завжди перевіряти заново — інакше браузер показує стару версію сайту після оновлення;
# файли в assets/ мають хеш у назві, їх можна кешувати надовго
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# стиснення тексту (знімок цін — ~150 КБ JSON, стиснутий — ~15 КБ)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript text/javascript application/json application/xml image/svg+xml
</IfModule>
