# файли мапи (плитки, векторні шари, мапа для гри) мають версію в адресі (?v=MAP_V, src/lib/mapGeo.ts):
# нова мапа — нова адреса, тож кешувати можна на рік. Змінив будь-який файл у public/map — підніми MAP_V
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|jpg|bin|json|zip)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
